<?xml version="1.0" encoding="utf-8"?>
<!--
    اندروید ۱۲+ جای allowBackup این فایل را می‌خواند: هم بکاپ ابری و هم انتقال
    دستگاه‌به‌دستگاه بسته است تا دیتابیس مغازه هیچ‌وقت از گوشی بیرون نرود.
    راه بکاپ همان فایل ZIP خود برنامه است («بیشتر ← داده‌ها و بکاپ»).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
